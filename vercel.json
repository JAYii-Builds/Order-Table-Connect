{
  "buildCommand": "pnpm --filter @workspace/restaurant-app run build",
  "outputDirectory": "artifacts/restaurant-app/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "build": {
    "env": {
      "BASE_PATH": "/"
    }
  }
}
